{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "$HOME/.claude/hooks/guard.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  },
  "language": "English",
  "model": "fixture-claude",
  "permissions": {
    "allow": [
      "Read",
      "Bash(fixture check:*)"
    ],
    "ask": [
      "Bash(dangerouslyDisableSandbox:true)",
      "Bash(fixture publish:*)"
    ],
    "defaultMode": "acceptEdits",
    "deny": [
      "Read(**/secrets/**)",
      "Edit(**/secrets/**)",
      "Bash(fixture destroy:*)"
    ]
  },
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "."
      ],
      "denyWrite": []
    }
  },
  "statusLine": {
    "command": "$HOME/.claude/statusline/statusline.sh",
    "type": "command"
  }
}
