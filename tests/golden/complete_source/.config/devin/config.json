{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "$HOME/.devin/hooks/hook_adapter.py shell forbidden",
            "type": "command"
          }
        ],
        "matcher": "exec"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Exec(fixture check)"
    ],
    "ask": [
      "Exec(fixture publish)"
    ],
    "deny": [
      "Exec(fixture destroy)"
    ]
  }
}
