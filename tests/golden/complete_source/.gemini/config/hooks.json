{
  "agent-harness": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "$HOME/.gemini/config/hooks/hook_adapter.py shell forbidden",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "command": "$HOME/.gemini/config/hooks/hook_adapter.py stop",
        "type": "command"
      }
    ]
  }
}
