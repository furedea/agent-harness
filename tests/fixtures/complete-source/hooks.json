{
  "version": 1,
  "claude": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard.sh"
          }
        ]
      }
    ]
  },
  "codex": {
    "hooks": {
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "$HOME/.codex/hooks/adapt.sh $HOME/.codex/hooks/guard.sh"
            }
          ]
        }
      ]
    }
  }
}
