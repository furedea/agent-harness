{
  "version": 1,
  "claude": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard.sh"
          }
        ]
      }
    ]
  },
  "codex": {
    "hooks": {
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "$HOME/.codex/hooks/adapt.sh $HOME/.codex/hooks/guard.sh"
            }
          ]
        }
      ]
    }
  },
  "devin": {
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "exec",
          "hooks": [
            {
              "type": "command",
              "command": "$HOME/.devin/hooks/hook_adapter.py shell forbidden"
            }
          ]
        }
      ]
    }
  },
  "hermes": {
    "hooks": {
      "pre_tool_call": [
        {
          "matcher": "^(terminal|exec_command)$",
          "hooks": [
            {
              "type": "command",
              "command": "$HOME/.hermes/hooks/hook_adapter.py shell forbidden"
            }
          ]
        }
      ]
    }
  },
  "pi": {
    "hooks": {
      "tool_call": [
        {
          "matcher": "^bash$",
          "hooks": [
            {
              "type": "command",
              "command": "$HOME/.pi/hooks/hook_adapter.py shell forbidden"
            }
          ]
        }
      ]
    }
  }
}
