{
  "model": "fixture-claude",
  "language": "English",
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline/statusline.sh"
  },
  "permissions": {
    "allow": ["Read"],
    "ask": ["Bash(dangerouslyDisableSandbox:true)"],
    "deny": [],
    "defaultMode": "acceptEdits"
  },
  "sandbox": {
    "filesystem": {
      "allowWrite": ["."],
      "denyWrite": []
    }
  }
}
